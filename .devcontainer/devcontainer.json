{
  "name": "OpenCode - Google Maps Scraper",
  "image": "mcr.microsoft.com/devcontainers/go:1-bookworm",
  "forwardPorts": [4096],
  "portsAttributes": {
    "4096": {
      "label": "OpenCode Web",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash .devcontainer/install-opencode.sh",
  "postStartCommand": "bash .devcontainer/start-opencode.sh",
  "remoteUser": "vscode"
}
